---
// Contents list for the docs home page. Each item is one row: a linked title, a short summary, and an
// optional status on the right (for example, a live page count).
import { withBase } from '../lib/paths';

interface Props {
	items: { href: string; title: string; summary: string; status?: string }[];
}

const { items } = Astro.props;
---

<ol class="ru-index not-content">
	{
		items.map((item) => (
			<li>
				<a href={withBase(item.href)}>{item.title}</a>
				<p>{item.summary}</p>
				{item.status && <span class="ru-index-status">{item.status}</span>}
			</li>
		))
	}
</ol>

<style>
	.ru-index {
		margin: 2rem 0 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--ru-text);
	}
	.ru-index li {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 15rem) minmax(0, 1fr) auto;
		gap: 0.25rem 1.5rem;
		align-items: baseline;
		padding: 0.875rem 0 0.9375rem;
		border-bottom: 1px solid var(--ru-rule);
	}
	.ru-index a {
		font-size: var(--sl-text-lg);
		font-weight: 700;
		font-stretch: 112%;
		letter-spacing: -0.01em;
		line-height: 1.3;
		color: var(--ru-text);
		text-decoration: none;
	}
	/* The whole row is the link target. */
	.ru-index a::after {
		content: '';
		position: absolute;
		inset: 0;
	}
	.ru-index li:hover {
		background: var(--ru-hover);
	}
	.ru-index li:hover a {
		text-decoration: underline;
		text-decoration-color: var(--ru-accent);
		text-decoration-thickness: 1px;
		text-underline-offset: 0.2em;
	}
	.ru-index a:focus-visible {
		outline: none;
	}
	.ru-index a:focus-visible::after {
		outline: 2px solid var(--ru-accent);
		outline-offset: -2px;
	}
	.ru-index p {
		margin: 0;
		color: var(--ru-text-2);
		line-height: 1.5;
	}
	.ru-index-status {
		font-size: var(--sl-text-sm);
		font-variant-numeric: tabular-nums;
		color: var(--ru-text-2);
		white-space: nowrap;
	}
	@media (max-width: 40rem) {
		.ru-index li {
			grid-template-columns: minmax(0, 1fr) auto;
		}
		.ru-index p {
			grid-column: 1 / -1;
			grid-row: 2;
		}
	}
</style>
