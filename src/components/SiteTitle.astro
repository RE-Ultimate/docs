---
// Replaces Starlight's site title with the Re:Ultimate pixel wordmark (the Crest brand's primary logo).
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="ru-brand">
	<span class="ru-wordmark ru-brand-word" translate="no">Re<span class="ru-colon">:</span>Ultimate</span>
	<span class="ru-brand-section">Docs</span>
</a>

<style>
	.ru-brand {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		min-width: 0;
		color: var(--ru-text);
		text-decoration: none;
		white-space: nowrap;
	}
	.ru-brand-word {
		font-size: 1.375rem;
		/* Room for the extrusion below the letters. */
		padding-bottom: 0.2em;
	}
	.ru-brand-section {
		padding-inline-start: 0.75rem;
		border-inline-start: 1px solid var(--ru-rule-strong);
		font-family: var(--ru-font-ui);
		font-size: 0.9375rem;
		line-height: 1;
		color: var(--ru-text-2);
	}
	.ru-brand:hover .ru-brand-section {
		color: var(--ru-accent);
	}
	@media (max-width: 24rem) {
		.ru-brand-word {
			font-size: 1.125rem;
		}
		.ru-brand-section {
			display: none;
		}
	}
</style>
