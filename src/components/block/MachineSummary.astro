---
// The machine itself: its in-game window with a slot legend (src/data/machine-guis), then the facts from
// the details file: power, accepted inputs, products, automation faces, and tips.
// Recipes it processes are under "Processing examples".
import AnchorHeading from '@astrojs/starlight/components/AnchorHeading.astro';
import type { BlockDetailsView } from '../../lib/block-details';
import { SECTION_TITLES } from '../../lib/block-details';
import type { MachineGui } from '../../lib/machine-gui-schema.ts';
import MachineWindow from './MachineWindow.astro';

interface Props {
	machine: BlockDetailsView['machine'];
	gui: MachineGui | undefined;
}

const { gui } = Astro.props;
const machine = Astro.props.machine ?? { power: undefined, inputs: [], outputs: [], automation: [], tips: [] };
const lists = [
	{ label: 'Accepts', items: machine.inputs },
	{ label: 'Produces', items: machine.outputs },
].filter((list) => list.items.length > 0);
---

<section class="ru-machine not-content">
	<AnchorHeading level={2} id="machine">{SECTION_TITLES.machine}</AnchorHeading>

	{gui && <MachineWindow gui={gui} legend />}

	{
		machine.power && (
			<dl class="ru-facts">
				<div>
					<dt>Power</dt>
					<dd>{machine.power}</dd>
				</div>
			</dl>
		)
	}

	{
		lists.length > 0 && (
			<div class="ru-io">
				{lists.map((list) => (
					<div>
						<h3>{list.label}</h3>
						<ul>
							{list.items.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					</div>
				))}
			</div>
		)
	}

	{
		machine.automation.length > 0 && (
			<>
				<h3>Automation</h3>
				<table class="ru-table ru-faces">
					<thead>
						<tr>
							<th scope="col">Face</th>
							<th scope="col">Role</th>
						</tr>
					</thead>
					<tbody>
						{machine.automation.map((face) => (
							<tr>
								<th scope="row">{face.face}</th>
								<td>{face.role}</td>
							</tr>
						))}
					</tbody>
				</table>
			</>
		)
	}

	{
		machine.tips.length > 0 && (
			<>
				<h3>Tips</h3>
				<ul class="ru-tips">
					{machine.tips.map((tip) => (
						<li>{tip}</li>
					))}
				</ul>
			</>
		)
	}
</section>
